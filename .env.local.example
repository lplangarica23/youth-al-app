# Copy this file to .env.local and fill in your own values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for seeding (npm run seed) and the /admin approval page.
# Settings -> API -> service_role (secret). NEVER commit this or expose
# it with a NEXT_PUBLIC_ prefix — it bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails allowed to approve/reject submissions
# at /admin. Use the email you'll sign up to youth.al with.
ADMIN_EMAILS=you@example.com

# Needed for the AI-assisted submission tool (paste a post, get a
# structured draft). Get a key at console.anthropic.com — this is a
# real, paid API (very cheap per use, but not free). Without this set,
# the "Analizo me AI" button shows an error, but manual entry still
# works fine via the "Ose plotëso manualisht" link on the same page.
# Needed for the AI-assisted submission tool and the AI chat.
# Get a free key at aistudio.google.com — Google's Gemini API has a
# genuinely free ongoing tier (no credit card needed), unlike
# Anthropic's one-time trial credit. Worth knowing: on the free tier,
# Google's terms allow using your prompts to help train their models —
# that's part of how "free" works there. If that matters to your
# privacy policy (it should), disclose it plainly rather than hide it.
GEMINI_API_KEY=your-gemini-api-key
