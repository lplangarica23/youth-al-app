# Copy this file to .env.local and fill in your own values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for seeding (npm run seed) and the /admin approval page.
# Settings -> API -> service_role (secret). NEVER commit this or expose
# it with a NEXT_PUBLIC_ prefix — it bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails allowed to approve/reject submissions
# at /admin. Use the email you'll sign up to youth.al with.
ADMIN_EMAILS=you@example.com
